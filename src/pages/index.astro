---
// src/pages/index.astro
// Composes all sections in order.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/content.js';

// Pass SEO data to the layout
const { title, description, ogImage, url } = site;
---
<Layout title={title} description={description} ogImage={ogImage} url={url}>
  <Navbar />

  <main>
    <Hero />
    <About />
    <Experience />
    <Projects />
    <Skills />
    <Education />
    <Contact />
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Alternating background tint & subtle hairline dividers on even sections for visual rhythm */
  main > section:nth-child(even) {
    background: var(--surface-alt);
    border-block: 1px solid var(--border);
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
</style>
