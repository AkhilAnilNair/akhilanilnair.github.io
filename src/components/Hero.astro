---
// src/components/Hero.astro
import { person } from '../data/content.js';
---
<section id="hero" class="hero">
  <div class="container hero-inner">
    <p class="hero-eyebrow mono muted">Hi, I'm</p>
    <h1 class="hero-name">{person.name}</h1>
    <p class="hero-role">{person.role}</p>
    <p class="hero-tagline">{person.tagline}</p>

    <div class="hero-cta">
      <a href="#projects" class="btn btn-primary">View Projects</a>
      <a href={person.resumeUrl} class="btn btn-secondary" download>
        <!-- Download icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15"
          viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download Resume
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 7rem 5rem;
    min-height: 85svh;
    display: flex;
    align-items: center;
  }

  .hero-eyebrow {
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .hero-name {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text);
  }

  .hero-role {
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: var(--accent);
    font-weight: 500;
    margin-top: 0.4rem;
    letter-spacing: -0.01em;
  }

  .hero-tagline {
    max-width: 540px;
    color: var(--muted);
    margin-top: 1.25rem;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (max-width: 480px) {
    .hero { padding-block: 5rem 3rem; min-height: 80svh; }
    .hero-cta { flex-direction: column; }
    .btn { justify-content: center; }
  }
</style>
