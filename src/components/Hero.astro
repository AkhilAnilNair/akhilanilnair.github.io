---
// src/components/Hero.astro
import { person } from '../data/content.js';
---
<section id="hero" class="hero">
  <!-- Cartesian plane (squares) fading away from center to edges with interactive cursor gradient -->
  <div class="hero-grid-plane" aria-hidden="true">
    <div class="hero-grid-base"></div>
    <div class="hero-grid-spotlight">
      <div class="hero-spotlight-glow"></div>
      <div class="hero-spotlight-lines"></div>
    </div>
  </div>

  <div class="container hero-inner">
    <p class="hero-eyebrow mono muted">Hi, I'm</p>
    <h1 class="hero-name"><span class="gradient-text">{person.name}</span></h1>
    <p class="hero-role">{person.role}</p>
    <p class="hero-tagline">{person.tagline}</p>

    <div class="hero-cta">
      <a href="#projects" class="btn btn-primary">View Projects</a>
      <a href={person.resumeUrl} class="btn btn-secondary" download>
        <!-- Download icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15"
          viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download Resume
      </a>
    </div>

    <div class="hero-socials">
      <!-- GitHub icon -->
      <a href={person.github} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub Profile" title="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>

      <!-- LinkedIn icon -->
      <a href={person.linkedin} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn Profile" title="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
      </a>

      <!-- Email icon -->
      <a href={`mailto:${person.email}`} class="social-btn" aria-label="Send Email" title="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  function setupHeroGrid() {
    const hero = document.getElementById('hero');
    if (!hero) return;

    const spotlight = hero.querySelector('.hero-grid-spotlight');
    if (!spotlight) return;

    let rafId = null;
    let targetX = -9999;
    let targetY = -9999;
    let currentX = -9999;
    let currentY = -9999;
    let isHovered = false;

    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function render() {
      if (isReducedMotion) {
        currentX = targetX;
        currentY = targetY;
        hero.style.setProperty('--mouse-x', `${currentX}px`);
        hero.style.setProperty('--mouse-y', `${currentY}px`);
        rafId = null;
        return;
      }

      // Smooth trailing factor for fluid motion
      const dx = targetX - currentX;
      const dy = targetY - currentY;
      currentX += dx * 0.22;
      currentY += dy * 0.22;

      hero.style.setProperty('--mouse-x', `${currentX.toFixed(1)}px`);
      hero.style.setProperty('--mouse-y', `${currentY.toFixed(1)}px`);

      if (Math.hypot(dx, dy) > 0.2 && isHovered) {
        rafId = requestAnimationFrame(render);
      } else {
        currentX = targetX;
        currentY = targetY;
        hero.style.setProperty('--mouse-x', `${currentX}px`);
        hero.style.setProperty('--mouse-y', `${currentY}px`);
        rafId = null;
      }
    }

    hero.addEventListener('pointerenter', (e) => {
      const rect = hero.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;
      currentX = targetX;
      currentY = targetY;
      hero.style.setProperty('--mouse-x', `${currentX}px`);
      hero.style.setProperty('--mouse-y', `${currentY}px`);
      isHovered = true;
      spotlight.classList.add('is-active');
    });

    hero.addEventListener('pointermove', (e) => {
      const rect = hero.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;

      if (!isHovered) {
        isHovered = true;
        spotlight.classList.add('is-active');
      }

      if (!rafId) {
        rafId = requestAnimationFrame(render);
      }
    }, { passive: true });

    hero.addEventListener('pointerleave', () => {
      isHovered = false;
      spotlight.classList.remove('is-active');
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    });
  }

  setupHeroGrid();
  document.addEventListener('astro:page-load', setupHeroGrid);
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 7rem 5rem;
    min-height: 85svh;
    display: flex;
    align-items: center;
    --grid-size: 55px;
    --spotlight-radius: 260px;
    --mouse-x: -9999px;
    --mouse-y: -9999px;
  }

  /* Cartesian Plane Container */
  .hero-grid-plane {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    overflow: hidden;
  }

  /* Base Cartesian Plane: square grid fading away from center to edges */
  .hero-grid-base {
    position: absolute;
    inset: 0;
    background-size: var(--grid-size) var(--grid-size);
    background-position: center center;
    background-image:
      linear-gradient(to right, var(--hero-grid-color, rgba(20, 20, 31, 0.08)) 1px, transparent 1px),
      linear-gradient(to bottom, var(--hero-grid-color, rgba(20, 20, 31, 0.08)) 1px, transparent 1px);
    mask-image: radial-gradient(
      ellipse 70% 65% at 50% 50%,
      #000 15%,
      rgba(0, 0, 0, 0.45) 50%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 70% 65% at 50% 50%,
      #000 15%,
      rgba(0, 0, 0, 0.45) 50%,
      transparent 80%
    );
  }

  /* Interactive Hover Spotlight: enlarged soft radius around cursor */
  .hero-grid-spotlight {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
    will-change: mask-position, -webkit-mask-position, opacity;
    mask-image: radial-gradient(
      circle var(--spotlight-radius, 260px) at var(--mouse-x) var(--mouse-y),
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.45) 35%,
      rgba(0, 0, 0, 0.18) 65%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      circle var(--spotlight-radius, 260px) at var(--mouse-x) var(--mouse-y),
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.45) 35%,
      rgba(0, 0, 0, 0.18) 65%,
      transparent 100%
    );
  }

  .hero-grid-spotlight.is-active {
    opacity: 1;
  }

  /* Slowly moving animated gradient matching the portfolio's accent aesthetic */
  .hero-spotlight-glow,
  .hero-spotlight-lines {
    position: absolute;
    inset: 0;
    background: var(--hero-gradient, linear-gradient(135deg, #6D28D9 0%, #4F46E5 35%, #06B6D4 70%, #6D28D9 100%));
    background-size: 300% 300%;
    animation: heroGradientShift 8s ease-in-out infinite alternate;
  }

  /* Subtle ambient glow in the square cells around mouse */
  .hero-spotlight-glow {
    opacity: var(--hero-glow-opacity, 0.05);
  }

  /* Highlighted Cartesian grid lines around mouse — subtle and refined */
  .hero-spotlight-lines {
    opacity: var(--hero-lines-highlight-opacity, 0.55);
    mask-image:
      linear-gradient(to right, #000 1px, transparent 1px),
      linear-gradient(to bottom, #000 1px, transparent 1px);
    -webkit-mask-image:
      linear-gradient(to right, #000 1px, transparent 1px),
      linear-gradient(to bottom, #000 1px, transparent 1px);
    mask-size: var(--grid-size) var(--grid-size);
    -webkit-mask-size: var(--grid-size) var(--grid-size);
    mask-position: center center;
    -webkit-mask-position: center center;
  }

  @keyframes heroGradientShift {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-spotlight-glow,
    .hero-spotlight-lines {
      animation: none;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .hero-name {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text);
  }

  .hero-role {
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: var(--accent);
    font-weight: 500;
    margin-top: 0.4rem;
    letter-spacing: -0.01em;
  }

  .hero-tagline {
    max-width: 540px;
    color: var(--muted);
    margin-top: 1.25rem;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero-socials {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius);
    border: 1.5px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease,
                background-color 0.25s ease, box-shadow 0.2s ease;
  }

  .social-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.08);
  }

  @media (max-width: 480px) {
    .hero { padding-block: 5rem 3rem; min-height: 80svh; }
    .hero-cta { flex-direction: column; }
    .btn { justify-content: center; }
  }
</style>
