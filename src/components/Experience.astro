---
// src/components/Experience.astro
import { experience } from '../data/content.js';
---
<section id="experience" class="fade-in">
  <div class="container">
    <p class="section-label">Experience</p>
    <h2 class="section-title">Work <span class="gradient-text">History</span></h2>

    <ol class="timeline" reversed>
      {experience.map((job) => (
        <li class="timeline-item">
          <!-- Left rail — dot + line -->
          <div class="timeline-rail" aria-hidden="true">
            <div class="timeline-dot"></div>
            <div class="timeline-line"></div>
          </div>

          <!-- Content -->
          <div class="timeline-content">
            <div class="job-header">
              <div>
                <h3 class="job-title">{job.title}</h3>
                <p class="job-company">
                  {job.company}
                  <span class="muted"> · {job.location}</span>
                </p>
              </div>
              <span class="job-dates mono muted">{job.start} – {job.end}</span>
            </div>

            <ul class="job-bullets">
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>

            <!-- Tech tags -->
            <div class="tag-row">
              {job.stack.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* ── Timeline layout ── */
  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0 1.5rem;
  }

  /* Rail: dot at the top, vertical line below */
  .timeline-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.4rem;
  }
  .timeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
  .timeline-line {
    flex: 1;
    width: 1px;
    background: var(--border);
    margin-top: 6px;
    min-height: 2rem;
  }
  .timeline-item:last-child .timeline-line { display: none; }

  /* ── Job content ── */
  .timeline-content {
    padding-bottom: 3rem;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-bottom: 1rem;
  }

  .job-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }

  .job-company {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 0.1rem;
  }

  .job-dates {
    font-size: 0.78rem;
    white-space: nowrap;
    padding-top: 0.2rem;
  }

  .job-bullets {
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  @media (max-width: 540px) {
    .job-header { flex-direction: column; }
    .timeline-item { grid-template-columns: 1rem 1fr; gap: 0 1rem; }
  }
</style>
