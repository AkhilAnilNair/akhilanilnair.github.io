---
// src/components/ThemeToggle.astro
// Feature 10: title now mentions the "T" keyboard shortcut.
---
<button
  id="theme-toggle"
  class="theme-btn"
  aria-label="Toggle colour theme"
  title="Toggle theme (T)"
>
  <!-- Sun icon — visible in light mode -->
  <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="17" height="17"
    viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    aria-hidden="true">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1"  x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22"   x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1"  y1="12" x2="3"  y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <!-- Moon icon — visible in dark mode -->
  <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="17" height="17"
    viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<!--
  is:inline runs immediately so the button is interactive before the
  Astro bundle loads. The same toggle logic is duplicated in the
  command palette and keyboard shortcut T handler — all three stay in sync
  because they all write to the same data-theme attribute + localStorage.
-->
<script is:inline>
  document.getElementById('theme-toggle').addEventListener('click', function () {
    var html = document.documentElement;
    console.log(html);
    var next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    console.log(next);
    html.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    padding: 0.4rem;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .theme-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Show sun in light mode, moon in dark mode */
  .icon-sun  { display: block; }
  .icon-moon { display: none; }

  :global([data-theme="dark"]) .icon-sun  { display: none; }
  :global([data-theme="dark"]) .icon-moon { display: block; }
</style>
