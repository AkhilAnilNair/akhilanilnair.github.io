---
// src/components/Involvement.astro
import { achievements, leadership, community } from '../data/content.js';
---
<section id="involvement" class="fade-in">
  <div class="container">
    <p class="section-label">Leadership &amp; Impact</p>
    <h2 class="section-title">Honors &amp; <span class="gradient-text">Involvement</span></h2>

    <!-- ── 1. Honors & Achievements ─────────────────────────── -->
    <div class="subsection">
      <h3 class="sub-heading">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="6"/>
          <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
        </svg>
        Honors &amp; Achievements
      </h3>
      <ul class="achievements-list" role="list">
        {achievements.map((item) => (
          <li class={`achievement-item ${item.highlight ? 'achievement-highlight' : ''}`}>
            <div class="achievement-main">
              <div class="achievement-title-row">
                <span class="achievement-title">{item.title}</span>
                {item.highlight && (
                  <span class="achievement-badge">Top Award</span>
                )}
              </div>
              <p class="achievement-org muted">
                {item.organization}
                {item.location && <span> · {item.location}</span>}
              </p>
              {item.description && (
                <p class="achievement-desc muted">{item.description}</p>
              )}
            </div>
            <span class="achievement-year mono muted">{item.year}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- ── 2. Leadership Roles ───────────────────────────────── -->
    <div class="subsection">
      <h3 class="sub-heading">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Leadership Roles
      </h3>
      <ul class="leadership-list" role="list">
        {leadership.map((item) => (
          <li class="leadership-item">
            <div class="leadership-rail" aria-hidden="true">
              <div class="leadership-dot"></div>
              <div class="leadership-line"></div>
            </div>
            <div class="leadership-content">
              <div class="leadership-header">
                <div>
                  <span class="leadership-role">{item.role}</span>
                  <p class="leadership-org muted">{item.organization}</p>
                </div>
                <span class="leadership-period mono muted">{item.period}</span>
              </div>
              {item.description && (
                <p class="leadership-desc muted">{item.description}</p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- ── 3. Community Involvement ──────────────────────────── -->
    <div class="subsection">
      <h3 class="sub-heading">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        Community Involvement
      </h3>
      <div class="community-grid">
        {community.map((item) => (
          <div class="community-card">
            <div class="community-card-header">
              <div>
                <span class="community-org">{item.organization}</span>
                {item.location && (
                  <span class="community-location muted"> · {item.location}</span>
                )}
              </div>
              <span class="community-period mono muted">{item.period}</span>
            </div>
            <ul class="community-bullets" role="list">
              {item.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Shared subsection spacing ── */
  .subsection {
    margin-bottom: 3rem;
  }
  .subsection:last-child {
    margin-bottom: 0;
  }

  /* ── Sub-heading (mono uppercase label with icon) ── */
  .sub-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }
  .sub-heading svg {
    flex-shrink: 0;
    opacity: 0.75;
  }

  /* ═══════════════════════════════════════════════════
     1. ACHIEVEMENTS
  ═══════════════════════════════════════════════════ */
  .achievements-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .achievement-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s ease;
    border-radius: 6px;
  }
  .achievement-item:first-child {
    border-top: 1px solid var(--border);
  }
  .achievement-item:hover {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  /* Highlight the top award */
  .achievement-highlight {
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    border-color: color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .achievement-highlight:first-child {
    border-top-color: color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .achievement-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .achievement-title-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .achievement-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .achievement-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 20px;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .achievement-org {
    font-size: 0.875rem;
    margin: 0;
  }

  .achievement-desc {
    font-size: 0.85rem;
    margin: 0.1rem 0 0;
    line-height: 1.55;
  }

  .achievement-year {
    font-size: 0.78rem;
    white-space: nowrap;
    padding-top: 0.15rem;
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════════════════
     2. LEADERSHIP — mini-timeline
  ═══════════════════════════════════════════════════ */
  .leadership-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .leadership-item {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0 1.25rem;
  }

  .leadership-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.35rem;
  }
  .leadership-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
  .leadership-line {
    flex: 1;
    width: 1px;
    background: var(--border);
    margin-top: 5px;
    min-height: 1.5rem;
  }
  .leadership-item:last-child .leadership-line { display: none; }

  .leadership-content {
    padding-bottom: 1.75rem;
  }

  .leadership-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-bottom: 0.4rem;
  }

  .leadership-role {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
  }

  .leadership-org {
    font-size: 0.85rem;
    margin: 0.1rem 0 0;
  }

  .leadership-period {
    font-size: 0.75rem;
    white-space: nowrap;
    padding-top: 0.1rem;
  }

  .leadership-desc {
    font-size: 0.875rem;
    margin: 0;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ═══════════════════════════════════════════════════
     3. COMMUNITY — card grid
  ═══════════════════════════════════════════════════ */
  .community-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .community-card {
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .community-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow: 0 4px 16px -6px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .community-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .community-org {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }

  .community-location {
    font-size: 0.85rem;
  }

  .community-period {
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .community-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }
  .community-bullets li {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    padding-left: 1rem;
    position: relative;
  }
  .community-bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .achievement-item { flex-direction: column; gap: 0.3rem; }
    .achievement-year { align-self: flex-end; }
    .community-grid { grid-template-columns: 1fr; }
    .leadership-item { grid-template-columns: 1rem 1fr; gap: 0 1rem; }
  }
</style>
