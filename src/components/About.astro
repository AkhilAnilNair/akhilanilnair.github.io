---
// src/components/About.astro
import { about } from '../data/content.js';
---
<section id="about" class="fade-in">
  <div class="container">
    <p class="section-label">About</p>
    <h2 class="section-title">Personal <span class="gradient-text">Background</span></h2>
    <div class="about-body">
      {about.map((para) => <p>{para}</p>)}
    </div>
  </div>
</section>

<style>
  .about-body {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  /* Highlight the first paragraph slightly more */
  .about-body p:first-child {
    color: var(--text);
  }
</style>
